# ════════════════════════════════════════════════════════════════════
# StudyFlow247 - Environment Variables Configuration
# ════════════════════════════════════════════════════════════════════

# ── 1. BACKEND ENVIRONMENT VARIABLES (Set in Render Dashboard or .env locally) ──

# Node Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origin (for CORS)
FRONTEND_URL=https://studyflow247.netlify.app

# Google Gemini AI (Required for AI Syllabus Parser & PYQ Analyzer)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase Database & Auth (Backend Verification & Sync)
# Found in: Supabase Project Settings -> API
SUPABASE_URL=https://wunghwovfpwbwforqeaq.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7N7nid5nIBmgcD8N1zmfng_ohYSrKrd
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: SUPABASE_SERVICE_ROLE_KEY (Only on server, NEVER share in frontend)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Express Session Secret (Generate a strong 32+ character random string for production)
SESSION_SECRET=your_32_character_random_session_secret_key_here

# Optional: MongoDB URI (if using legacy MongoDB storage alongside Supabase)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/studyflow

# Optional: SMTP Nodemailer Settings (for verification / achievement emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM="StudyFlow" <your_email@gmail.com>


# ── 2. FRONTEND ENVIRONMENT CONFIGURATION (Netlify / Static Hosting) ──
#
# The frontend is hosted statically on Netlify.
# Public configuration is maintained in:
#   - js/api-config.js (API base URL / Render backend URL)
#   - js/supabase-config.js (Supabase URL and Publishable Key)
#   - _redirects / netlify.toml (Netlify API proxy to Render backend)
#
# IMPORTANT SECURITY RULES:
# - NEVER put GEMINI_API_KEY into any frontend HTML or JS file.
# - NEVER put SUPABASE_SERVICE_ROLE_KEY into any frontend file.
# - Only public publishable keys belong in frontend code.
