# ════════════════════════════════════════════════════════════════════
# StudyFlow - Syllabus Study Planner Environment Configuration
# ════════════════════════════════════════════════════════════════════

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Session Secret (Generate a strong 32+ character random string for production)
SESSION_SECRET=your_super_secret_session_key_replace_this_in_production_2026

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/studyflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/syllabus_study_planner

# Email Verification Provider (SMTP / Nodemailer)
# For Gmail: Use smtp.gmail.com with an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="StudyFlow" <your_email@gmail.com>

# Gemini AI Syllabus Parser (Google Gen AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
